# Existing Vanya bot stays separate. Keep BOT_TOKEN empty for site integration.
# Non-empty BOT_TOKEN starts the legacy polling adapter in non-demo; do not duplicate consumers.
# Never commit real secrets.
BOT_TOKEN=
# Legacy/non-demo admin allowlist: comma separated numeric Telegram user IDs.
ADMIN_IDS=
# Required for production web administration: generate at least 32 random characters.
ADMIN_TOKEN=
PORT=8787
# Keep loopback. Expose through an HTTPS reverse proxy, never raw Node port.
HOST=127.0.0.1
# Telegram Login / OIDC (BotFather → Login Widget). Secrets stay on the server.
# Register https://your-domain/auth/telegram/callback in Allowed URLs.
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
PUBLIC_ORIGIN=
