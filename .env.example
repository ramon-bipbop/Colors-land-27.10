# Create your own bot with @BotFather; never commit this file with real secrets.
BOT_TOKEN=
# Comma separated numeric Telegram user IDs; each admin must /start the bot.
ADMIN_IDS=
# Required for production web administration: generate at least 32 random characters.
ADMIN_TOKEN=
PORT=8787
# Keep loopback. Expose through an HTTPS reverse proxy, never raw Node port.
HOST=127.0.0.1
# Telegram Login / OIDC (BotFather → Login Widget). Secrets stay on the server.
# Register https://your-domain/auth/telegram/callback in Allowed URLs.
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
PUBLIC_ORIGIN=
